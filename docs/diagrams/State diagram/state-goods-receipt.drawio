        <mxCell id="paid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã tất toán&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo : Double = 0&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ xác nhận trả đủ công nợ&lt;br/&gt;do/ lưu lịch sử phiếu nhập&lt;br/&gt;exit/ kết thúc theo dõi nợ&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="240" x="1410" y="200" as="geometry" />
