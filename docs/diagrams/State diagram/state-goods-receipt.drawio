        <mxCell id="init" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="26" width="26" x="30" y="262" as="geometry" />
        </mxCell>
        <mxCell id="draft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đang lập phiếu nhập&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Bản nháp&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ mở biểu mẫu lập phiếu&lt;br/&gt;do/ nhập NCC, sách, SL, giá nhập&lt;br/&gt;exit/ kiểm tra tính hợp lệ&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="160" y="200" as="geometry" />
        </mxCell>
        <mxCell id="unpaid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Chưa thanh toán&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo : Double = tongTien&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ lưu phiếu, cộng tồn kho&lt;br/&gt;do/ theo dõi hạn trả công nợ&lt;br/&gt;exit/ ghi nhận giao dịch trả nợ&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="260" x="570" y="200" as="geometry" />
        </mxCell>
        <mxCell id="partial" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã thanh toán một phần&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;0 &lt; conNo &lt; tongTien&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ cập nhật số tiền đã trả&lt;br/&gt;do/ theo dõi số dư nợ còn lại&lt;br/&gt;exit/ cập nhật trạng thái công nợ&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="260" x="990" y="200" as="geometry" />
