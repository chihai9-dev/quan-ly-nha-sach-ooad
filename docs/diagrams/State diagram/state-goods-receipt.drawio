<mxfile host="Electron">
  <diagram name="Trạng thái - Phiếu nhập kho" id="state-goods-receipt">
    <mxGraphModel dx="489" dy="301" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;SƠ ĐỒ TRẠNG THÁI – PHIẾU NHẬP KHO &amp; CÔNG NỢ NHÀ CUNG CẤP&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="450" y="15" as="geometry" />
