        <mxCell id="overdue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Quá hạn công nợ&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo &gt; 0, quaHan = true&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ phát cảnh báo nợ đến hạn&lt;br/&gt;do/ hiển thị cảnh báo công nợ&lt;br/&gt;exit/ gỡ cảnh báo khi tất toán&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="260" x="990" y="490" as="geometry" />
