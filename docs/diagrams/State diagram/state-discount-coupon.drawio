        <mxCell id="e1" value="Phát hành mã(ma)&lt;br/&gt;[mã chưa tồn tại]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="init" target="active">
