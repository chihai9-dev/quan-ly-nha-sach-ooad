        <mxCell id="e6" edge="1" parent="1" source="onLeave" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" target="terminated" value="Thôi việc()">
