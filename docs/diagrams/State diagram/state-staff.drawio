        <mxCell id="e8" edge="1" parent="1" source="terminated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" target="endTerm" value="">
