<mxfile host="Electron">
  <diagram name="Trạng thái - Nhân viên" id="state-staff">
    <mxGraphModel dx="848" dy="522" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;SƠ ĐỒ TRẠNG THÁI – HỒ SƠ NHÂN VIÊN&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="200" y="15" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="26" width="26" x="40" y="239.5" as="geometry" />
        </mxCell>
        <mxCell id="active" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đang làm việc&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Đang làm&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ kích hoạt hồ sơ nhân sự&lt;br/&gt;do/ thực hiện nghiệp vụ được gán&lt;br/&gt;exit/ cập nhật biến động nhân sự&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="260" x="200" y="180" as="geometry" />
        </mxCell>
        <mxCell id="onLeave" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đang tạm nghỉ&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Tạm nghỉ&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ ghi nhận thời gian nghỉ&lt;br/&gt;do/ tạm hoãn phân công ca trực&lt;br/&gt;exit/ xác nhận quay lại hoặc nghỉ hẳn&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="260" x="650" y="180" as="geometry" />
        </mxCell>
        <mxCell id="terminated" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã thôi việc&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Đã thôi việc&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ vô hiệu hóa tài khoản liên kết&lt;br/&gt;do/ lưu trữ lịch sử làm việc&lt;br/&gt;exit/ đóng hồ sơ nhân sự&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="260" x="650" y="460" as="geometry" />
        </mxCell>
        <mxCell id="endDelete" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="300" y="440" as="geometry" />
        </mxCell>
        <mxCell id="endTerm" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1060" y="518" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" target="active" value="Thêm nhân viên()&lt;br/&gt;[dữ liệu hợp lệ]">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-22" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" target="active" value="Chỉnh sửa hồ sơ(thongTin) [hợp lệ]">
          <mxGeometry relative="1" as="geometry">
