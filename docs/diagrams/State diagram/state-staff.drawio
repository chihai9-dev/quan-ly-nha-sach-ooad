        <mxCell id="e7" edge="1" parent="1" source="active" style="rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=0.45;exitY=1;elbow=vertical;" target="endDelete" value="Xóa()&lt;br/&gt;[chưa có ràng buộc]">
