          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" target="terminated" value="Thôi việc hoặc xóa()&lt;br/&gt;[có ràng buộc dữ liệu]">
