        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• PENDING / COMPLETED / CANCELLED khớp cột orders.status trong schema.sql.&lt;br&gt;• RETURNED là trạng thái đề xuất mở rộng (đi kèm Invoice.payment_status = REFUNDED).&lt;br&gt;• Yêu cầu đổi/trả không thỏa guard (quá 7 ngày, sách hư hỏng) bị từ chối, đơn giữ nguyên COMPLETED." vertex="1">
          <mxGeometry height="110" width="380" x="540" y="610" as="geometry" />
        </mxCell>
