        <mxCell id="e6" value="Xác nhận hoàn tất()&lt;br/&gt;/ cộng sách cũ, trừ sách mới()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="exchanging" target="completed">
          <mxGeometry relative="1" as="geometry">
