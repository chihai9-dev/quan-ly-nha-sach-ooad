        <mxCell id="e7" value="Xác nhận hoàn tất()&lt;br/&gt;/ cộng tồn, cập nhật hóa đơn()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="refunding" target="completed">
