<mxfile host="app.diagrams.net">
  <diagram name="Trạng thái - Phiếu nhập kho" id="state-goods-receipt">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ TRẠNG THÁI – PHIẾU NHẬP KHO &amp; CÔNG NỢ NHÀ CUNG CẤP&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="450" y="15" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đang lập phiếu nhập&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Bản nháp&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ mở biểu mẫu lập phiếu&lt;br/&gt;do/ nhập NCC, sách, SL, giá nhập&lt;br/&gt;exit/ kiểm tra tính hợp lệ&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="200" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="unpaid" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Chưa thanh toán&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo : Double = tongTien&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ lưu phiếu, cộng tồn kho&lt;br/&gt;do/ theo dõi hạn trả công nợ&lt;br/&gt;exit/ ghi nhận giao dịch trả nợ&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="partial" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã thanh toán một phần&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;0 &lt; conNo &lt; tongTien&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ cập nhật số tiền đã trả&lt;br/&gt;do/ theo dõi số dư nợ còn lại&lt;br/&gt;exit/ cập nhật trạng thái công nợ&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="200" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="overdue" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Quá hạn công nợ&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo &gt; 0, quaHan = true&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ phát cảnh báo nợ đến hạn&lt;br/&gt;do/ hiển thị cảnh báo công nợ&lt;br/&gt;exit/ gỡ cảnh báo khi tất toán&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="490" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="paid" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã tất toán&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;conNo : Double = 0&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ xác nhận trả đủ công nợ&lt;br/&gt;do/ lưu lịch sử phiếu nhập&lt;br/&gt;exit/ kết thúc theo dõi nợ&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="200" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="endCancel" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
