        <mxCell id="eUnpaidPartial" value="Thanh toán(soTien)&lt;br/&gt;[0 &amp;lt; soTien &amp;lt; conNo]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="unpaid" target="partial">
          <mxGeometry relative="1" as="geometry">
