        <mxCell id="ePartialLoop" value="Thanh toán thêm(soTien)&lt;br/&gt;[soTien &amp;lt; conNo]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="partial" target="partial">
