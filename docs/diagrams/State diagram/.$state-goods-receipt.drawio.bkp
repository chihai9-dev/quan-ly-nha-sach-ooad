          <mxGeometry relative="1" as="geometry">
            <mxPoint x="65" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eDraftUnpaid" value="Lưu phiếu()&lt;br/&gt;[dữ liệu hợp lệ]&lt;br/&gt;/ cộng tồn kho()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="draft" target="unpaid">
          <mxGeometry relative="1" as="geometry">
