<mxfile host="app.diagrams.net">
  <diagram name="Trạng thái - Kiểm kê kho" id="state-stock-audit">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1550" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ TRẠNG THÁI – PHIẾU KIỂM KÊ &amp; ĐIỀU CHỈNH KHO&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="325" y="15" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="295" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="counting" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đang kiểm đếm&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Đang kiểm kê&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ tải danh sách tồn hệ thống&lt;br/&gt;do/ nhập số lượng thực tế&lt;br/&gt;exit/ đối chiếu số liệu tồn&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="235" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="choice" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="288" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="balanced" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Khớp tồn kho&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;chenhLech : int = 0&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ ghi nhận kết quả khớp kho&lt;br/&gt;do/ lưu lịch sử kiểm kê&lt;br/&gt;exit/ kết thúc đợt kiểm kê&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="90" width="250" height="135" as="geometry" />
        </mxCell>
        <mxCell id="discrepancy" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Có chênh lệch&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;chenhLech : int != 0&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ hiển thị danh sách lệch kho&lt;br/&gt;do/ chờ lập phiếu điều chỉnh&lt;br/&gt;exit/ ghi nhận nguyên nhân lệch&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="290" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="adjusted" value="&lt;p style=&quot;margin:0;padding:6px 8px;text-align:center;&quot;&gt;&lt;b&gt;Đã cân bằng kho&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;trangThai : String = &quot;Đã điều chỉnh&quot;&lt;/p&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000000;margin:0;&quot;/&gt;&lt;p style=&quot;margin:0;padding:5px 8px;&quot;&gt;entry/ lưu phiếu điều chỉnh kho&lt;br/&gt;do/ cập nhật lại số lượng tồn&lt;br/&gt;exit/ thông báo cân bằng xong&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacing=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="290" width="250" height="145" as="geometry" />
