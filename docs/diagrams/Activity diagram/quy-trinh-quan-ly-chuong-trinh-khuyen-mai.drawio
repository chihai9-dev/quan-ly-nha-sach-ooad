        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam conditionStyle diamond\nskinparam defaultTextAlignment center\n\n|Quản lý|\nstart\n:Chọn menu \&quot;Danh sách Khuyến mãi\&quot;;\n\n|Giao diện|\n:Gửi yêu cầu tải danh sách KM;\n\n|Hệ thống|\n:Truy xuất danh sách chương trình KM;\n\n|Database|\n:Trả về dữ liệu KM;\n\n|Hệ thống|\nif () then ([Dữ liệu rỗng])\n    |Giao diện|\n    :Hiển thị \&quot;Chưa có dữ liệu\&quot; &amp; Nút \&quot;Tạo mới ngay\&quot;;\n    stop\nelse ([Có dữ liệu])\n    |Hệ thống|\n    :Xử lý danh sách;\n    |Giao diện|\n    :Hiển thị danh sách các chương trình KM;\nendif\n\n|Quản lý|\nif () then ([Thêm mới / Chỉnh sửa])\n    :Nhập/Thay đổi thông tin KM (thời gian, mức giảm, phạm vi) &amp; Nhấn \&quot;Lưu\&quot;;\n    |Giao diện|\n    :Gửi dữ liệu thiết lập KM;\n    |Hệ thống|\n    :Kiểm tra quy tắc (Tên không trống, % giảm hợp lệ, Ngày hợp lệ);\n    if () then ([Lỗi thời gian / Mức giảm])\n        :Báo lỗi không cho lưu;\n        |Giao diện|\n        :Hiển thị thông báo \&quot;Thời gian hoặc Mức giảm không hợp lệ\&quot;;\n        |Quản lý|\n        stop\n    else ([Hợp lệ])\n        |Hệ thống|\n        :Kiểm tra tính xung đột sản phẩm/danh mục;\n        if () then ([Trùng lặp KM khác])\n            :Từ chối lưu;\n            |Giao diện|\n            :Hiển thị cảnh báo \&quot;Sản phẩm X đang trùng khuyến mãi\&quot;;\n            |Quản lý|\n            stop\n        else ([Hoàn toàn hợp lệ])\n            |Hệ thống|\n            :Tiến hành lưu mới / Cập nhật ghi đè;\n            |Database|\n            :Lưu thông tin chương trình KM;\n            |Hệ thống|\n            :Xác nhận thành công;\n            |Giao diện|\n            :Hiển thị thông báo thành công &amp; Cập nhật danh sách;\n            |Quản lý|\n            stop\n        endif\n    endif\n\nelse ([Hủy / Ngừng KM])\n    |Quản lý|\n    :Nhấn nút \&quot;Hủy / Ngưng\&quot; tại chương trình đang diễn ra;\n    |Giao diện|\n    :Hiển thị hộp thoại xác nhận ngưng chương trình;\n    |Quản lý|\n    if () then ([Bấm \&quot;Không\&quot;])\n        |Giao diện|\n        :Đóng hộp thoại, giữ nguyên trạng thái;\n        |Quản lý|\n        stop\n    else ([Bấm \&quot;Đồng ý\&quot;])\n        |Giao diện|\n        :Gửi yêu cầu ngưng KM;\n        |Hệ thống|\n        :Đổi trạng thái KM thành \&quot;Đã ngưng\&quot;;\n        |Database|\n        :Cập nhật trạng thái vào CSDL;\n        |Hệ thống|\n        :Xác nhận cập nhật thành công;\n        |Giao diện|\n        :Hiển thị thông báo thành công &amp; Làm mới danh sách;\n        |Quản lý|\n        stop\n    endif\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yjrcUrXpsQbqfXE8xlYg-550">
